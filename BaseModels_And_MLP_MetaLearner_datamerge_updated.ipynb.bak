   "source": [
    "# ── Refit base models on the full local training split ────────────────────────\n",
    "# Before scoring the holdout, the base models are refit so they use all available\n",
    "# training rows (CV folds each saw only 4/5 of the data).\n",
    "#\n",
    "# >>> NOTE: this fits on X_train (the 80% split), not X_train_full. For the FINAL\n",
    "# Kaggle submission you'd refit on 100% of the labelled data for maximum signal.\n",
    "# The meta-learner itself should stay trained on OOF predictions (do NOT refit it\n",
    "# on these in-sample base predictions, or it will overfit).\n",
    "\n",
    "#Train all model on whole tranining data - \n",
    "rf_model.fit(X_train,y_train)\n",
    "\n",
    "xgb_model.fit(X_train,y_train)\n",
    "\n",
    "lgb_model.fit(X_train,y_train)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "117e3b6b-9528-4990-b48f-38176f9365b0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(61502,)\n",
      "(61502, 3)\n"
     ]
    }
   ],
   "source": [
    "# ── Build the meta-learner TEST matrix from base-model holdout probabilities ──\n",
    "#\n",
    "# >>> BUG (critical): two problems here.\n",
    "#   1. rf_preds is duplicated and lgb_preds is missing, mirroring the training bug.\n",
    "#   2. The COLUMN ORDER differs from the training matrix:\n",
    "#        train: [rf_oof,  rf_oof,  lgb_oof]   (col 3 = LightGBM)\n",
    "#        test : [rf_preds, rf_preds, xgb_preds] (col 3 = XGBoost)\n",
    "#      The meta-learner is fed LightGBM in column 3 at train time but XGBoost at\n",
    "#      test time, so it scores on features that don't mean what it learned. This\n",
    "#      train/serve skew is the most likely reason the ensemble underperforms its\n",
    "#      base models. Both matrices must use the identical order, e.g.:\n",
    "#        x_test_meta = np.column_stack([xgb_preds, rf_preds, lgb_preds])\n",
    "\n",
    "    # Test meta  learner on test data \n",
    "    from sklearn.impute import SimpleImputer\n",
    "\n",
    "    # imputer = SimpleImputer(strategy=\"median\")\n",
    "    # X_train_inputed=imputer.fit_transform(X_train)\n",
    "    # X_test_imputed = imputer.fit_transform(X_test)\n",
    "    # lr.fit(X_train_inputed,y_train)\n",
    "    # rf.fit(X_train_inputed,y_train)\n",
    "    # xgb.fit(X_train_inputed,y_train)\n",
    "\n",
    "    rf_preds = rf_model.predict_proba(X_test)[:,1]\n",
    "    xgb_preds = xgb_model.predict_proba(X_test)[:,1]\n",
    "    lgb_preds = lgb_model.predict_proba(X_test)[:,1]\n",
    "\n",
    "\n",
    "    #Data set for Meta learner\n",
    "    x_test_meta = np.column_stack([rf_preds,rf_preds,xgb_preds])\n",
    "\n",
    "    y_test_meta=y_test\n",
    "    print(y_test_meta.shape)\n",
    "    print(x_test_meta.shape)"
   ]
  },
