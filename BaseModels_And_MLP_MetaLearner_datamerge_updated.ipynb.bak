   ],
   "source": [
    "# ── 5-fold Stratified CV: train base models & collect OOF probabilities ───────\n",
    "# For each fold: fit XGB/RF/LGBM on 4 folds, predict the held-out fold, and store\n",
    "# those predictions in the *_oof arrays. Because every training row is predicted\n",
    "# exactly once while it is OUT of the training set, the OOF probabilities are\n",
    "# leakage-free and are what the meta-learner will train on.\n",
    "#\n",
    "# Imbalance handling per model: XGB scale_pos_weight=11.4 (~91/9 ratio),\n",
    "# RF class_weight='balanced', LGBM is_unbalance=True.\n",
    "#\n",
    "# >>> NOTE: xgb_roc_auc = roc_auc_score(y_val_fold, xgb_preds[val_idx]) passes\n",
    "# HARD 0/1 predictions instead of probabilities, so XGB's reported AUC is\n",
    "# understated. RF and LGBM correctly use *_proba. For a fair comparison use\n",
    "# roc_auc_score(y_val_fold, xgb_proba).\n",
    "\n",
    "CV = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "#Train and evaluate models using cross-validation\n",
    "# Train Probabilities for each model\n",
    "xgb_oof = np.zeros(len(X_train))\n",
    "rf_oof = np.zeros(len(X_train)) \n",
    "lgb_oof = np.zeros(len(X_train))\n",
    "xgb_preds=np.zeros(len(X_train))\n",
    "rf_preds=np.zeros(len(X_train))\n",
    "lgb_preds=np.zeros(len(X_train))\n",
    "\n",
    "\n",
    "# Test Probabilities for each model\n",
    "xgb_test_proba = []\n",
    "rf_test_probas = []\n",
    "lgb_test_probas = []\n",
    "\n",
    "y_val_all = np.zeros(len(X_train))\n",
    "\n",
    "#XGBoost\n",
    "print(\"Creating XGBoost...\")\n",
    "xgb_model = xgb.XGBClassifier(\n",
    "n_estimators=100,\n",
    "learning_rate=0.1,\n",
    "max_depth=5,\n",
    "min_child_weight=1,\n",
    "gamma=0,\n",
    "subsample=0.8,\n",
    "colsample_bytree=0.8,\n",
    "objective=\"binary:logistic\",\n",
    "eval_metric=\"auc\",\n",
    "reg_alpha=0.1,\n",
    "reg_lambda=2,\n",
    "random_state=42,\n",
    "scale_pos_weight=11.4  # Adjust for class imbalance if necessary\n",
    "# early_stopping_rounds=50,\n",
    ")\n",
    "\n",
    "#Random Forest\n",
    "print(\"Creating Random Forest...\")\n",
    "rf_model = RandomForestClassifier(\n",
    "n_estimators=100,\n",
    "max_depth=10,\n",
    "min_samples_split=20,\n",
    "min_samples_leaf=10,\n",
    "random_state=42,\n",
    "class_weight=\"balanced\",  # Adjust for class imbalance\n",
    "max_features=\"sqrt\",  # Use sqrt of features for better performance\n",
    ")\n",
    "\n",
    "#LightGBM\n",
    "print(\"Creating LightGBM...\")\n",
    "lgb_model = lgb.LGBMClassifier(\n",
    "n_estimators=1000,\n",
    "learning_rate=0.05,\n",
    "max_depth=5,\n",
    "min_child_weight=1,\n",
    "min_child_samples=100,\n",
    "subsample=0.8,\n",
    "colsample_bytree=0.8,\n",
    "objective='binary',\n",
    "n_jobs=-1,\n",
    "random_state=42,\n",
    "reg_alpha=0.1,\n",
    "reg_lambda=1,\n",
    "num_leaves=20,\n",
    "force_col_wise=True,\n",
    "is_unbalance=True,\n",
    ")\n",
    "\n",
    "# Train Models and Evaluate\n",
    "for nfold, (train_idx, val_idx) in enumerate(CV.split(X_train, y_train), start=1):\n",
    "    print(f\"Fold {nfold}\")\n",
    "    X_train_fold, X_val_fold = X_train.iloc[train_idx], X_train.iloc[val_idx]\n",
    "    y_train_fold, y_val_fold = y_train.iloc[train_idx], y_train.iloc[val_idx]\n",
    "\n",
    "    # Collect validation labels\n",
    "\n",
    "        # Train XGBoost\n",
    "    print(\"Training XGBoost...\")\n",
    "    xgb_model.fit(X_train_fold, y_train_fold, eval_set=[(X_val_fold, y_val_fold)], verbose=0)\n",
    "    # Train Random Forest\n",
    "    print(\"Training Random Forest...\")\n",
    "    rf_model.fit(X_train_fold, y_train_fold)\n",
    "    # Train LightGBM\n",
    "    print(\"Training LightGBM...\")\n",
    "    lgb_model.fit(X_train_fold, y_train_fold)\n",
    "\n",
    "    #Evaluation Metrics for XGBoost\n",
    "    xgb_preds[val_idx] = xgb_model.predict(X_val_fold)\n",
    "    xgb_proba = xgb_model.predict_proba(X_val_fold)[:, 1]\n",
    "    xgb_oof[val_idx] = xgb_proba\n",
    "    xgb_test_proba.append(xgb_model.predict_proba(X_test)[:, 1])     \n",
    "\n",
    "    xgb_accuracy = accuracy_score(y_val_fold,  xgb_preds[val_idx])\n",
    "    xgb_precision = precision_score(y_val_fold,  xgb_preds[val_idx])\n",
    "    xgb_recall = recall_score(y_val_fold,  xgb_preds[val_idx])\n",
    "    xgb_f1 = f1_score(y_val_fold,  xgb_preds[val_idx])\n",
    "    xgb_fbeta = fbeta_score(y_val_fold,  xgb_preds[val_idx], beta=2)\n",
    "    xgb_roc_auc = roc_auc_score(y_val_fold, xgb_proba)  # use probabilities, not hard 0/1 preds\n",
    "    xgb_report = classification_report(y_val_fold,  xgb_preds[val_idx])\n",
    "    xgb_conf_matrix = confusion_matrix(y_val_fold,  xgb_preds[val_idx])\n",
    "    print(f\"XGBoost - \\nAccuracy: {xgb_accuracy:.4f}, \\nPrecision: {xgb_precision:.4f}, \\nRecall: {xgb_recall:.4f}, \\nF1: {xgb_f1:.4f}, \\nF-beta: {xgb_fbeta:.4f}, \\nROC AUC: {xgb_roc_auc:.4f}\", f\"\\nClassification Report:\\n{xgb_report}\", f\"\\nConfusion Matrix:\\n{xgb_conf_matrix}\")   \n",
    "\n",
    "    #ROC Curve for XGBoost\n",
    "    RocCurveDisplay.from_estimator(xgb_model, X_val_fold, y_val_fold)\n",
    "    plt.title(f\"ROC Curve - XGBoost Fold {nfold}\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    #Evaluation Metrics for Random Forest\n",
    "    rf_preds[val_idx] = rf_model.predict(X_val_fold)\n",
    "    rf_proba = rf_model.predict_proba(X_val_fold)[:, 1]\n",
    "\n",
    "    rf_oof[val_idx] = rf_proba\n",
    "    rf_test_probas.append(rf_model.predict_proba(X_test)[:, 1])  # collect for fold-averaging\n",
    "\n",
    "    # rf_test_proba = rf_model.predict_proba(X_test)[:, 1]\n",
    "    # rf_test_probas.append(rf_test_proba)\n",
    "    # rf_probas.append(rf_proba)\n",
    "    rf_accuracy = accuracy_score(y_val_fold, rf_preds[val_idx])\n",
    "    rf_precision = precision_score(y_val_fold, rf_preds[val_idx])\n",
    "    rf_recall = recall_score(y_val_fold, rf_preds[val_idx])\n",
    "    rf_f1 = f1_score(y_val_fold, rf_preds[val_idx])\n",
    "    rf_fbeta = fbeta_score(y_val_fold, rf_preds[val_idx], beta=2)\n",
    "    rf_roc_auc = roc_auc_score(y_val_fold, rf_proba)\n",
    "    rf_report = classification_report(y_val_fold, rf_preds[val_idx])\n",
    "    rf_conf_matrix = confusion_matrix(y_val_fold, rf_preds[val_idx])\n",
    "    print(f\"Random Forest - \\nAccuracy: {rf_accuracy:.4f}, \\nPrecision: {rf_precision:.4f}, \\nRecall: {rf_recall:.4f}, \\nF1: {rf_f1:.4f}, \\nF-beta: {rf_fbeta:.4f}, \\nROC AUC: {rf_roc_auc:.4f}\", f\"\\nClassification Report:\\n{rf_report}\", f\"\\nConfusion Matrix:\\n{rf_conf_matrix}\")\n",
    "\n",
    "\n",
    "    # ROC Curve for Random Forest\n",
    "    RocCurveDisplay.from_estimator(rf_model, X_val_fold, y_val_fold)\n",
    "    plt.title(f\"ROC Curve - Random Forest Fold {nfold}\")\n",
    "    plt.show()\n",
    "\n",
    "    \n",
    "\n",
    "    #Evaluation Metrics for LightGBM\n",
    "    lgb_preds[val_idx] = lgb_model.predict(X_val_fold)\n",
    "    lgb_proba = lgb_model.predict_proba(X_val_fold)[:, 1]\n",
    "    lgb_oof[val_idx]=lgb_proba\n",
    "\n",
    "    \n",
    "    # lgb_test_proba = lgb_model.predict_proba(X_test)[:, 1]\n",
    "    # lgb_test_probas.append(lgb_test_proba)\n",
    "    # lgb_probas.append(lgb_proba)\n",
    "    lgb_accuracy = accuracy_score(y_val_fold, lgb_preds[val_idx])\n",
    "    lgb_precision = precision_score(y_val_fold, lgb_preds[val_idx])\n",
    "    lgb_recall = recall_score(y_val_fold, lgb_preds[val_idx])\n",
    "    lgb_f1 = f1_score(y_val_fold, lgb_preds[val_idx])\n",
    "    lgb_fbeta = fbeta_score(y_val_fold, lgb_preds[val_idx], beta=2)\n",
    "    lgb_roc_auc = roc_auc_score(y_val_fold, lgb_proba)\n",
    "    lgb_report = classification_report(y_val_fold, lgb_preds[val_idx])\n",
    "    lgb_conf_matrix = confusion_matrix(y_val_fold, lgb_preds[val_idx])\n",
    "    print(f\"LightGBM - \\nAccuracy: {lgb_accuracy:.4f}, \\nPrecision: {lgb_precision:.4f}, \\nRecall: {lgb_recall:.4f}, \\nF1: {lgb_f1:.4f}, \\nF-beta: {lgb_fbeta:.4f}, \\nROC AUC: {lgb_roc_auc:.4f}\", f\"\\nClassification Report:\\n{lgb_report}\", f\"\\nConfusion Matrix:\\n{lgb_conf_matrix}\")\n",
    "\n",
    "    # ROC Curve for LightGBM\n",
    "    RocCurveDisplay.from_estimator(lgb_model, X_val_fold, y_val_fold)\n",
    "    plt.title(f\"ROC Curve - LightGBM Fold {nfold}\")\n",
    "    plt.show()\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "1f4aa28c-958a-4d99-8de2-eecd0410e16d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Meta-learner definition ───────────────────────────────────────────────────\n",
    "# A small MLP (32→16, ReLU, Adam) that learns the optimal non-linear combination\n",
    "# of the three base-model OOF probabilities. early_stopping guards against\n",
    "# overfitting the tiny 3-feature meta dataset.\n",
    "\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "meta_model = MLPClassifier(\n",
    "    hidden_layer_sizes=(32,16),\n",
    "    activation='relu',\n",
    "    solver=\"adam\",\n",
    "    learning_rate_init=0.001,\n",
    "    max_iter=1000,\n",
    "    random_state=42,\n",
    "    n_iter_no_change=10,\n",
    "    alpha=1e-3,\n",
    "    early_stopping=True,\n",
    "    validation_fraction=0.1\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "31c3ce76-75fa-4cd6-a790-764a4adee16d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(246005, 3)\n",
      "(246005,)\n"
     ]
    }
   ],
   "source": [
    "# ── Assemble the meta-learner TRAINING matrix from OOF probabilities ──────────\n",
    "# Each column is one base model's out-of-fold probability for the positive class.\n",
    "#\n",
    "# >>> BUG: the stack is [rf_oof, rf_oof, lgb_oof] — rf_oof is duplicated and\n",
    "# xgb_oof is missing entirely. The meta-learner therefore never sees XGBoost and\n",
    "# sees Random Forest twice. This very likely caps the ensemble's AUC/F2.\n",
    "# Intended order:  x_meta = np.column_stack([xgb_oof, rf_oof, lgb_oof])\n",
    "# (and the TEST matrix in a later cell must use the SAME order — see the note there).\n",
    "\n",
    "#Data set for Meta learner\n",
    "x_meta = np.column_stack([\n",
    "      rf_oof,\n",
    "     rf_oof,\n",
    "    lgb_oof\n",
    "])\n",
    "y_meta = y_train.values\n",
    "print(x_meta.shape)   # (n_samples, n_base_models)\n",
    "print(y_meta.shape)  # (n_samples,)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "1101086a-b574-4fa0-b0a5-34e9297d20ba",
   "metadata": {},
   "outputs": [],
   "source": [
    "# (Optional) Diagnostic: correlation between base-model OOF predictions. Low\n",
    "# correlation = the models are diverse, which is exactly what makes stacking\n",
    "# pay off. Left commented out.\n",
    "\n",
    "# corr_matrix = pd.DataFrame({\n",
    "#    # \"lr\": oof_lr,\n",
    "#     \"rf\": oof_rf,\n",
    "#     \"xgb\": oof_xgb,\n",
    "#     \"lgbm\": oof_lgbm\n",
    "# }).corr()\n",
    "\n",
    "# print(corr_matrix)"
   ]
  },
