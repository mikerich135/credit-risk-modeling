    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "df_logistic saved: (356251, 690)\n"
     ]
    }
   ],
   "source": [
    "# Persist the logistic-ready frame for any future linear-model experiments.\n",
    "\n",
    "# Export Final Dataset\n",
    "df_logistic.to_csv(\"df_logistic_FINAL.csv\", index=False)\n",
    "print(\"df_logistic saved:\", df_logistic.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6fecd2a6",
   "metadata": {},
   "source": [
    "---\n",
    "# Step 7 — Base Models & MLP Meta-Learner (Stacking)\n",
    "\n",
    "This is the modelling core. Three diverse base learners (XGBoost, LightGBM, Random Forest) are trained\n",
    "with **5-fold Stratified CV** to generate leakage-free out-of-fold (OOF) probabilities. Those OOF\n",
    "probabilities become the training features for an **MLP meta-learner**, which learns how best to combine\n",
    "the base models. The final threshold is tuned for F2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "d7cc7b46",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Modelling imports ─────────────────────────────────────────────────────────\n",
    "# Base learners (XGB / LGBM / RF), the StackingClassifier utilities, metrics for\n",
    "# imbalanced evaluation (precision, recall, F1, F-beta, ROC-AUC) and\n",
    "# StratifiedKFold for class-balanced folds.\n",
    "\n",
    "#Implement home load default risk prediction using XGBoost, LightGBM and Random Forest and SVM as Meta Learner.\n",
    "#  Use CalibratedClassifierCV for hyperparameter tuning and evaluate the models using accuracy, precision, recall, F1-score, F-beta score and ROC AUC. Also include confusion matrix and classification report for each model.\n",
    "\n",
    "#import necessary libraries\n",
    "import xgboost as xgb\n",
    "import lightgbm as lgb\n",
    "from sklearn.ensemble import RandomForestClassifier, StackingClassifier\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.calibration import CalibratedClassifierCV\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.calibration import calibration_curve\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score, fbeta_score,\n",
    "    roc_auc_score, confusion_matrix, classification_report, RocCurveDisplay,\n",
    ")\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.datasets import make_classification\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from typing import Sequence\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "\n"
   ]
  },
